{
  "name": "capture",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src modules app test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check src app modules test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "eas": "eas",
    "expo": "expo",
    "deps:check": "expo install --check",
    "i18n:release-check": "node scripts/check-i18n-release.mjs",
    "contracts:vendor": "node scripts/vendor-contracts.mjs",
    "build:web": "expo export --platform web",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@seazn/engine": "npm:@seazn-club/seazn-engine@9.0.0",
    "@supabase/realtime-js": "2.118.0",
    "expo": "~58.0.26",
    "expo-brightness": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "qrcode-generator": "1.4.4",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.1",
    "@typescript-eslint/parser": "^8.70.0",
    "ajv": "8.11.0",
    "ajv-formats": "2.1.1",
    "eas-cli": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.1",
    "jsqr": "1.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5"
}
